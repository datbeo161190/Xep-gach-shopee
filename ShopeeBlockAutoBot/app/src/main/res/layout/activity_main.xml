<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Xếp Gạch Shopee (AI)"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tự nhận diện bảng 8x8, phân tích nước đi tối ưu và tự kéo thả khối gạch."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Cấp quyền bắt buộc"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Trạng thái: Đang kiểm tra..."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cấp quyền Hiển thị trên ứng dụng khác" />

            <Button
                android:id="@+id/btnAccessibilityPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bật Dịch vụ Trợ năng (Tự kéo thả)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Tinh chỉnh nhận diện &amp; kéo thả"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiftOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Độ nâng khối trên ngón tay: 2.1 ô"
                android:textColor="@color/text_light"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekLiftOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="45"
                android:progress="21" />

            <TextView
                android:id="@+id/tvMiniScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tỷ lệ ô khối chờ (so với bảng 8x8): 0.44"
                android:textColor="@color/text_light"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekMiniScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40"
                android:progress="14" />

            <TextView
                android:id="@+id/tvDragDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thời gian kéo 1 khối: 320 ms"
                android:textColor="@color/text_light"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekDragDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="17" />

            <TextView
                android:id="@+id/tvTurnDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Độ trễ chờ nạp 3 khối mới: 950 ms"
                android:textColor="@color/text_light"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekTurnDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="6" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="3. BẬT THANH ĐIỀU KHIỂN NỔI"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hướng dẫn nhanh:
• Bước 1: Cấp 2 quyền ở trên và bấm Bật Thanh Điều Khiển.
• Bước 2: Mở game Xếp Gạch Shopee.
• Bước 3: Bấm nút [Khung] trên thanh nổi, kéo khung xanh khớp bảng 8x8 và khung xanh dương khớp 3 khối bên dưới rồi bấm [Lưu].
• Bước 4: Bấm [Test] để kiểm tra nhận diện, sau đó bấm [1 Lượt] hoặc [Auto]!"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
